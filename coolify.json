{
  "version": "1.0.0",
  "deployment": {
    "type": "docker-compose",
    "file": "docker-compose.coolify.yml",
    "buildArgs": {},
    "env": {
      "GOOGLE_SEARCH_API_KEY": "${GOOGLE_SEARCH_API_KEY}",
      "GOOGLE_SEARCH_CX": "${GOOGLE_SEARCH_CX}",
      "BACKEND_URL": "${BACKEND_URL}",
      "FRONTEND_PORT": "7001",
      "BACKEND_PORT": "7000"
    }
  },
  "autoUpdate": true,
  "services": [
    {
      "id": "backend",
      "type": "docker",
      "image": "backend",
      "buildpack": {
        "builder": "heroku/buildpacks:20",
        "config": {
          "PYTHON_VERSION": "3.9"
        }
      },
      "dockerfile": {
        "path": "./backend/Dockerfile"
      },
      "ports": [
        {
          "published": 8000,
          "target": 8000
        }
      ],
      "volumes": [
        {
          "host": "./",
          "container": "/app/data"
        },
        {
          "host": "./backend/sample_data.csv",
          "container": "/app/sample_data.csv"
        }
      ],
      "environment": [
        {
          "name": "FALLBACK_CSV_PATH",
          "value": "/app/sample_data.csv"
        }
      ]
    },
    {
      "id": "frontend",
      "type": "docker",
      "image": "frontend",
      "dockerfile": {
        "path": "./frontend/Dockerfile"
      },
      "ports": [
        {
          "published": 3000,
          "target": 3000
        }
      ],
      "environment": [
        {
          "name": "REACT_APP_API_URL",
          "value": "http://localhost:8000"
        }
      ]
    }
  ]
} 