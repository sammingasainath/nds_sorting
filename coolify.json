{
  "version": "1.0.0",
  "deployment": {
    "type": "docker-compose",
    "file": "docker-compose.coolify.yml",
    "buildArgs": {},
    "env": {
      "GOOGLE_SEARCH_API_KEY": "${GOOGLE_SEARCH_API_KEY}",
      "GOOGLE_SEARCH_CX": "${GOOGLE_SEARCH_CX}",
      "BACKEND_URL": "${BACKEND_URL}",
      "FRONTEND_PORT": "3000",
      "BACKEND_PORT": "9000",
      "PWD": "/app"
    },
    "volumes": [
      {
        "source": "./Scores with Names.csv",
        "destination": "/app/Scores with Names.csv",
        "type": "bind"
      }
    ]
  },
  "autoUpdate": true
} 